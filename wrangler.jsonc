{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umami-analytics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "50b8de866954421eb4a4cea0e7af5b2c"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
